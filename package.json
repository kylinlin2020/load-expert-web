{
  "name": "load-expert-web",
  "version": "0.1.0",
  "description": "LoadExpert Web 版 - 现代 Web 装柜计算软件（Vue3 + TypeScript 全栈方案，算法引擎阶段）",
  "type": "module",
  "private": true,
  "scripts": {
    "genversion": "node scripts/gen-version.mjs",
    "build": "npm run genversion && tsc",
    "test": "npm run build && node --test dist/test/*.test.js && node --test deploy/cloudflare-worker/test-worker.mjs",
    "demo": "npm run build && node dist/scripts/demo.js",
    "server": "npm run build && node dist/src/server/index.js",
    "dev": "npm run genversion && vite",
    "dev:static": "npm run genversion && vite --mode static",
    "build:web": "npm run genversion && vite build",
    "build:web:static": "npm run genversion && vite build --mode static && node scripts/check-static-bundle.mjs",
    "check:static": "node scripts/check-static-bundle.mjs",
    "preview": "vite preview",
    "preview:static": "vite preview --mode static --outDir dist/web",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "loading",
    "container",
    "fillspace",
    "load-expert"
  ],
  "license": "GPL-3.0-only",
  "author": {
    "name": "Kylin",
    "url": "https://github.com/kylinlin2020"
  },
  "homepage": "https://github.com/kylinlin2020/load-expert-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylinlin2020/load-expert-web.git"
  },
  "bugs": {
    "url": "https://github.com/kylinlin2020/load-expert-web/issues"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^5.6.0",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fastify/cors": "^11.3.0",
    "element-plus": "^2.14.7",
    "fastify": "^5.12.5",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  }
}
