# ── 依赖 ──────────────────────────────────────────────
node_modules/

# ── 构建产物 ──────────────────────────────────────────
dist/

# ── 运行期数据 ────────────────────────────────────────
# data/ 里是**真实的货物 / 柜型 / 历史方案数据**（SQLite，含 WAL），
# 属于使用者本地数据，绝不能进版本库 —— 一旦提交历史就再也删不干净了。
data/
*.db
*.db-shm
*.db-wal

# ── 日志 ──────────────────────────────────────────────
logs/
*.log

# ── 本地环境覆盖 ──────────────────────────────────────
# .env.example 是模板，要入库；真实 .env 不入库
.env
.env.local
.env.*.local

# ── 编辑器 / 系统 ─────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 验证过程的临时产物 ─────────────────────────────────
# 浏览器面板截图（browser.capture 的落盘位置）
.openchamber/
# 诊断脚本跑完的临时产物
scripts/tmp-*.mjs
scripts/*.tmp