{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "src/algorithm/**/*.ts",
    "src/db/**/*.ts",
    "src/model/**/*.ts",
    "src/server/**/*.ts",
    "src/types/**/*.ts",
    "src/web/lib/**/*.ts",
    "src/web/api/**/*.ts",
    "src/web/env.d.ts",
    "test/**/*.ts",
    "scripts/**/*.ts"
  ]
}
